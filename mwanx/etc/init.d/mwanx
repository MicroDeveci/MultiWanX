#!/bin/sh /etc/rc.common
#
# /etc/init.d/mwanx
#
# 常驻守护进程，procd 会在它挂掉时自动拉起。

START=98
STOP=10
USE_PROCD=1

PROG=/usr/bin/mwanx

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 停机时把覆盖路由清掉，让 netifd 自己的默认路由接管，
	# 避免留下一条指向已失效网关的僵尸路由。
	"$PROG" clear 2>/dev/null
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger mwanx
}
